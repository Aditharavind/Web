# Export these variables in your process manager; the app does not auto-load .env.
ENVIRONMENT=production
SITE_URL=https://nawaglobalgtd.com
TRUSTED_HOSTS=nawaglobalgtd.com,www.nawaglobalgtd.com
DATABASE_URL=postgresql+psycopg2://nawa_app:REPLACE@127.0.0.1/nawa
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=REPLACE
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
SECURE_COOKIES=1
UPLOAD_DIR=/var/lib/nawa/uploads
CONTACT_WEBSITE=nawaglobalgtd.com
CONTACT_EMAIL=info@nawaglobalgtd.com
